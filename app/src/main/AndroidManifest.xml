<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="影视仓快捷启动" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
